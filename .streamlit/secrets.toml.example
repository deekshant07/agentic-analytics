# Copy this into Streamlit Cloud → App settings → Secrets
# Or copy to .streamlit/secrets.toml for local testing (already gitignored)

LLM_PROVIDER = "openai"
OPENAI_API_KEY = "sk-..."

# Alternatively, use Groq (free tier available)
# LLM_PROVIDER = "groq"
# GROQ_API_KEY = "your_groq_api_key"

# Optional: override specific model tiers
# LLM_STRONG_MODEL = "gpt-4o"
# LLM_MEDIUM_MODEL = "gpt-4o-mini"
# LLM_FAST_MODEL = "gpt-4o-mini"
